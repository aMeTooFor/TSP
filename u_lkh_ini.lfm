      end
      object Label83: TLabel
        Left = 280
        Height = 506
        Top = 5
        Width = 683
        Caption = '* EDGE_WEIGHT_TYPE：<string>'#13' *指定边缘权重（或距离）如何给出。值是：'#13' * ATT特殊距离功能的问题att48和att532'#13' * CEIL_2D权重是二进制四舍五入的欧氏距离'#13' * CEIL_3D重量是三维四舍五入的欧氏距离'#13' * EUC_2D权重是2-D中的欧几里德距离'#13' * EUC_3D权重是3-D中的欧几里德距离'#13' * EXPLICIT权重在相应部分中明确列出'#13' * GEO权重是地理距离，公里（TSPLIB）。坐标以DDD.MM的形式给出，其中DDD为度数，MM为分钟数'#13' * GEOM重量是以米为单位的地理距离（用于世界TSP）。坐标以十进制形式给出'#13' * GEO_MEEUS权重是以公里计算的地理距离，按照Meeus公式计算。坐标以DDD.MM的形式给出，'#13'其中DDD为度数，MM为分钟数'#13' * GEOM_MEEUS权重是地理距离，根据计算'#13' * Meeus''公式。坐标以十进制形式给出'#13' * MAN_2D重量是2-D中的曼哈顿距离'#13' * MAN_3D权重是3-D中的曼哈顿距离'#13' * MAX_2D重量是2-D的最大距离'#13' * MAX_3D重量是3-D的最大距离'#13' * XRAY1晶体学问题的距离函数（版本1）'#13' * XRAY2晶体学问题的距离函数（版本2）'#13' *特别实现了一个特殊的距离功能'#13' * Distance_SPECIAL功能。'
      end
      object Label84: TLabel
        Left = 143
        Height = 18
        Top = 8
        Width = 14
        Caption = ' = '
      end
