      object Label9: TLabel
        Left = 287
        Height = 110
        Top = 5
        Width = 685
        Caption = '* CANDIDATE_FILE = <string>'#13' *指定要写入候选集的文件的名称。但是，如果文件已经存在，则从文件中读取候选边。该文件的第一行'#13'包含节点数。以下每行包含节点编号，最小生成树中节点的父数（0，如果节点没有爸爸），从节点发出'#13'的候选边数，后跟候选边。对于每个候选边缘，给出其端节点数和α值。可以给出多个CANDIDATE_FILE'#13'规范。在这种情况下，读取给定的文件，并将其候选边的并集用作候选集。'
      end
      object Label10: TLabel
        Left = 144
        Height = 18
        Top = 8
        Width = 14
        Caption = ' = '
      end
