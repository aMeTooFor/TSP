    object Panel40: TCoolBar
      Left = 0
      Height = 158
      Hint = '40'
      Top = 1949
      Width = 1039
      Bands = <>
      Color = clWhite
      ParentColor = False
      ParentShowHint = False
      ShowHint = True
      object Label112: TLabel
        Left = 24
        Height = 18
        Top = 8
        Width = 128
        Caption = 'SUBPROBLEM_SIZE'
      end
      object Label113: TLabel
        Left = 287
        Height = 248
        Top = 5
        Width = 654
        Caption = '* SUBPROBLEM_SIZE = <integer> [DELAUNAY | KARP | K-CENTRE | K-MEANS | MOORE |'#13' ROHE | SIERPINSKI] [BORDERS] [COMPRESSED]     *默认值：-1。'#13' *将原始问题划分为子问题的节点数。根据由SUBPROBLEM_TOUR_FILE给出的巡视进行划分。值0'#13'表示不进行划分。默认情况下，通过将游览细分为相同大小的段来确定子问题。然而，整数可以跟'#13'着DELAUNAY，KARP，K-CENTER，K-MEANS，MOORE，ROHE或SIERPINSKI。 DELAUNAY指定使'#13'用Delaunay分区方案，KARP使用Karp的分区方案，K-CENTER表示基于K中心聚类的分区方案，'#13'K-MEANS，使用基于K均值聚类的分区方案，ROHE使用Rohe的随机矩阵分割方案，MOORE或'#13'SIERPINSKI使用基于Moore或Sierpinski空间填充曲线的分割方案。 BORDERS规范意味着子问题之间'#13'边界的子问题也被解决了。'#13' * COMPRESSED规范表示，通过从问题中删除所有节点，每个子问题都被压缩，其中两个事件子'#13'问题巡视边缘属于要合并的所有巡视（至少应给出两个MERGE_TOUR_FILE）。'
      end
      object Label114: TLabel
        Left = 144
        Height = 18
        Top = 8
        Width = 14
        Caption = ' = '
      end
