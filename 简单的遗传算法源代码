　　population[j].fitness = 0;
　　population[j].rfitness = 0;
　　population[j].cfitness = 0;
　　population[j].lower[i] = lbound;
　　population[j].upper[i]= ubound;
　　population[j].gene[i] = randval(population[j].lower[i],
　　population[j].upper[i]);
　　}
　　}
　　fclose(infile);
